DOMAIN=sudoku.murik.dev

POSTGRES_USER=sudoku
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sudoku
# password must match POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://sudoku:change_me@postgres:5432/sudoku

# From @BotFather. The app refuses to start without a well-formed token.
BOT_TOKEN=
WEBAPP_URL=https://sudoku.murik.dev
# WEBAPP_URL must equal https://DOMAIN, ignoring one trailing slash, and that exact
# value must be listed in ALLOWED_ORIGINS. For a local tunnel, set DOMAIN to the
# tunnel host with no scheme.
ALLOWED_ORIGINS=["https://sudoku.murik.dev"]
# true for a local run. Production sets false, and then TELEGRAM_WEBHOOK_SECRET is required.
TELEGRAM_USE_POLLING=true
# true in production. Left false here so a copied file does not poll the bot.
TELEGRAM_BOT_ENABLED=false
# Comma-separated Telegram user IDs allowed to /total, /broadcast, /send, and /cancel
ADMIN_TELEGRAM_IDS=
# Required in prod (TELEGRAM_USE_POLLING=false). A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# Backups. Read by deploy/*.sh on the host, not by the app. See docs/DEPLOY.md.
# Chat that gets the weekly encrypted dump, usually the owner's Telegram user ID.
BACKUP_TELEGRAM_CHAT_ID=
# Encrypts that dump. Keep a copy in a password manager: the dump cannot be opened without it.
BACKUP_PASSPHRASE=

# Puzzle pool is kept at the target size around the clock.
PUZZLE_POOL_TARGET_SIZE=50
PUZZLE_POOL_REFILL_INTERVAL_SECONDS=30
PUZZLE_POOL_REFILL_ENABLED=true

# Local dev ports
FRONTEND_DEV_PORT=5174
BACKEND_DEV_PORT=8002
POSTGRES_DEV_PORT=5434
# Signed initData for the dev frontend. docker-compose.dev.yml passes it to Vite.
# The script reads BOT_TOKEN from the environment; it does not load this file.
# From the repo root:
#   export BOT_TOKEN="$(sed -n 's/^BOT_TOKEN=//p' .env)"
#   cd backend && uv run python scripts/dev_init_data.py
# Expires 24 hours after auth_date. Leave empty to keep "Open this app from Telegram."
VITE_DEV_INIT_DATA=

# Backend tests do not read this file. Export a URL that names a *_test database first, e.g.
# export DATABASE_URL=postgresql+asyncpg://sudoku:change_me@localhost:5434/sudoku_test
